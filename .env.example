# Solo desarrollo local. Copiar a .env; no usar estas credenciales en AWS.
POSTGRES_DB=pavas
POSTGRES_USER=pavas_dev
POSTGRES_PASSWORD=pavas_local_only
POSTGRES_PORT=5432

# Los servicios leen .env desde la raiz y usan prefijos independientes.
CLIMA_ENVIRONMENT=development
CLIMA_LOG_LEVEL=INFO
# Completar y descomentar ambas coordenadas verificadas del balneario (WGS84).
# No usar las del centro de Tingo Maria. Sin ellas, las rutas de clima responden 503.
# CLIMA_LATITUDE=<latitud_verificada>
# CLIMA_LONGITUDE=<longitud_verificada>
AFLUENCIA_ENVIRONMENT=development
AFLUENCIA_LOG_LEVEL=INFO
